# Supabase project shared with the BGS Dashboard (Project Settings → API).
# Both values are public by design: the anon key can only read what row-level
# security allows (published articles and gallery photos).
# Without them the site uses the articles bundled in src/content/news.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional: shows a "Team login" link in the footer.
PUBLIC_DASHBOARD_URL=
