<style id="wp-custom-css">
/* Hide carousel during its initial speed adjustment */
.elementor-element-bd03acf .client-list {
    overflow: hidden !important;
    opacity: 0;
    animation: showLogoCarousel 0.4s ease forwards;
    animation-delay: 1s;
}

/* Maintain one constant speed */
.elementor-element-bd03acf .client-track {
    transition-property: transform !important;
    transition-duration: 3800ms !important;
    transition-timing-function: linear !important;
    transition-delay: 0ms !important;
    will-change: transform;
}

@keyframes showLogoCarousel {
    to {
        opacity: 1;
    }
}
</style>
</head>

<body class="home wp-singular page-template page-template-elementor_header_footer page page-id-13459 wp-embed-responsive wp-theme-gimont theme-gimont woocommerce-no-js give-test-mode give-page jkit-color-scheme chrome group-blog layout_2r woo_layout_1c elementor-default elementor-template-full-width elementor-kit-8 elementor-page elementor-page-13459" >
	
