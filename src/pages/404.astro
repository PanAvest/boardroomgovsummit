---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

// Rendered on demand so live pages (news articles) can fall through to it.
export const prerender = false;
---

<BaseLayout title="Page not found" noindex>
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1>This page has left the boardroom.</h1>
      <p class="lead">The page you're looking for may have moved when we rebuilt the site. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn" href="/">Go to the homepage <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost-light" href="/summit-2026/">BGS 2026 recap</a>
        <a class="btn btn--ghost-light" href="/news/">News &amp; insights</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    background: var(--navy-950);
    color: var(--white);
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
  }
  .nf__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .nf h1 {
    max-width: 14ch;
  }
  .nf .lead {
    color: rgba(255, 255, 255, 0.75);
    max-width: 50ch;
  }
</style>
