---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { partners2026, mediaPartners2026, pastPartners } from '../data/site';
import poster from '../assets/images/promo/bgs-2026-thank-you-sponsors.jpg';
import ctaImg from '../assets/images/events/2025/bgs-2025-430-of-465.jpg';

const groups = [
  { key: 'partners', name: 'Collaborators, associates & sponsors', items: partners2026 },
  { key: 'media', name: 'Media partners', items: mediaPartners2026 },
  { key: 'past', name: 'From earlier editions', items: pastPartners },
];
const all = groups
  .flatMap((g) => g.items.map((p) => ({ ...p, key: g.key })))
  .sort((x, y) => x.name.localeCompare(y.name));
---

<BaseLayout
  title="Partners"
  description="The government institutions, professional bodies and industry partners who have collaborated with, endorsed and sponsored the Boardroom Governance Summit."
>
  <PageHero
    compact
    eyebrow="Get to know"
    title="Past &amp; present collaborators, associates and sponsors."
    lead="BGS is made possible by organisations committed to advancing thoughtful corporate governance and boardroom leadership in Ghana and across Africa."
    crumbs={[{ label: 'Partners' }]}
  >
    <div class="btn-row">
      <a class="btn" href="/sponsorship/">Become a partner <Icon name="arrow-right" /></a>
      <span class="hero-count mono">{all.length} organisations across three editions</span>
    </div>
  </PageHero>

  <section class="section section--tight wall">
    <div class="container">
      <div class="wall__bar">
        <div class="wall__filters" role="toolbar" aria-label="Filter organisations">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All <span>{all.length}</span></button>
          {
            groups.map((g) => (
              <button type="button" class="chip" data-filter={g.key} aria-pressed="false">
                {g.name} <span>{g.items.length}</span>
              </button>
            ))
          }
        </div>
        <label class="wall__search">
          <span class="sr-only">Search organisations</span>
          <input class="input" type="search" placeholder="Search by name" data-search autocomplete="off" />
        </label>
      </div>

      <ul class="logos" data-wall>
        {
          all.map((p) => (
            <li data-key={p.key} data-name={p.name.toLowerCase()}>
              <div class="logos__img">
                <Image src={p.logo} alt="" height={90} densities={[1, 2]} />
              </div>
              <p>{p.name}</p>
            </li>
          ))
        }
      </ul>
      <p class="wall__empty" hidden>No organisation matches that search.</p>
      <p class="wall__count mono" data-count aria-live="polite">{all.length} organisations</p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container split">
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow eyebrow--gold">BGS 2026</p>
        <h2>A heartfelt thank you to our sponsors and partners.</h2>
        <p class="lead">
          The success of BGS 2026 would not have been possible without your support and commitment. We deeply
          appreciate your shared commitment to strengthening corporate governance, promoting responsible leadership and
          driving sustainable institutional growth across Africa.
        </p>
        <p><strong style="color:#fff">The BGS 2026 Organising Team</strong></p>
        <a class="link-arrow on-dark" href="/2026/11/13/thank-you-to-our-sponsors-and-partners/">Read the note <Icon name="arrow-right" /></a>
      </div>
      <div class="poster">
        <Image src={poster} alt="Thank you, sponsors and partners: BGS 2026 stakeholders, collaborators and partners" widths={[400, 700, 1000]} sizes="(min-width: 900px) 40vw, 92vw" />
      </div>
    </div>
  </section>

  <CtaBand
    image={ctaImg}
    title="Partner with BGS 2027."
    text="Join the institutions standing behind accountable leadership in Africa's boardrooms."
    primary={{ label: 'See sponsorship packages', href: '/sponsorship/' }}
    secondary={{ label: 'Contact us', href: '/contact/' }}
  />
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.wall [data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-wall] > li')];
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('.wall__empty')!;
  let filter = new URLSearchParams(location.search).get('show') ?? 'all';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const ok = (filter === 'all' || li.dataset.key === filter) && (!q || li.dataset.name!.includes(q));
      li.hidden = !ok;
      if (ok) shown++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    count.textContent = `${shown} ${shown === 1 ? 'organisation' : 'organisations'}`;
    empty.hidden = shown > 0;
  }
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      filter = c.dataset.filter!;
      apply();
    }),
  );
  search.addEventListener('input', apply);
  if (![...chips].some((c) => c.dataset.filter === filter)) filter = 'all';
  apply();
</script>

<style>
  .hero-count {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
  }
  .wall__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--ink);
  }
  .wall__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .chip span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .chip:hover {
    border-color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--white);
  }
  .chip[aria-pressed='true'] span {
    color: rgba(255, 255, 255, 0.7);
  }
  .wall__search {
    flex: 1 1 220px;
    max-width: 320px;
  }
  .wall__search .input {
    min-height: 44px;
    border-radius: 999px;
    padding-inline: 1.1rem;
  }
  .logos li[hidden] {
    display: none;
  }
  .wall__empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--muted);
  }
  .wall__count {
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--ink);
  }
  .group-head h2 {
    font-size: var(--fs-h3);
  }
  .group-head .mono {
    color: var(--muted);
  }
  .logos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 1rem;
  }
  .logos li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .logos__img {
    display: grid;
    place-items: center;
    height: 140px;
    padding: 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .logos li:hover .logos__img {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .logos__img :global(img) {
    max-height: 88px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
  .logos p {
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .poster {
    max-width: 460px;
    justify-self: center;
  }
  .poster :global(img) {
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
</style>
