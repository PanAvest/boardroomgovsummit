---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ThankYouBanner from '../components/ThankYouBanner.astro';
import EditionsTimeline from '../components/EditionsTimeline.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import LatestNews from '../components/LatestNews.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import SpeakerDialog from '../components/SpeakerDialog.astro';
import FaqList from '../components/FaqList.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import CtaBand from '../components/CtaBand.astro';
import { chairman, guestsOfHonour } from '../data/bgs2026';
import { stats, faqGroups, nextEdition, contact } from '../data/site';
import heroShots from '../data/gallery-2026.json';

import heroImg from '../assets/images/events/2026/bgs-2026-convener-address.jpg';
import wordmark2026 from '../assets/images/brand/bgs-2026-wordmark.png';
import about1 from '../assets/images/events/2025/bgs-2025-350-of-465.jpg';
import about2 from '../assets/images/events/2025/bgs-2025-349-of-465.jpg';
import about3 from '../assets/images/events/2025/bgs-2025-425-of-465.jpg';
import r1 from '../assets/images/events/2026/bgs-2026-group-photo.jpg';
import r2 from '../assets/images/events/2026/bgs-2026-chairman-address.jpg';
import r3 from '../assets/images/events/2026/bgs-2026-audience.jpg';
import convener from '../assets/images/people/douglas-boateng-stage-2024.jpg';
import videoPoster from '../assets/images/events/2025/bgs-2025-7-of-7.jpg';
import ctaImg from '../assets/images/events/2024/bgs-2024-161.jpg';

const faces = [chairman, ...guestsOfHonour.slice(0, 7)].map((p, i) => ({
  ...p,
  badge: i === 0 ? 'Chairman of the Summit' : undefined,
  tone: (['red', 'navy', 'ink', 'gold'] as const)[i % 4],
}));
const slides = [150, 175, 125, 350, 430, 100].map((i) => `/gallery/2026/full/${heroShots[i].name}.webp`);
const faqs = faqGroups.flatMap((g) => g.items).slice(0, 4);

const takeaways = [
  { n: '01', title: 'Competence, not convenience', text: 'Committee composition must follow mandate. An audit committee without real financial expertise cannot fulfil its purpose.' },
  { n: '02', title: 'Real mandates, real independence', text: 'Clear terms of reference, unrestricted access to information and the right to independent advice.' },
  { n: '03', title: 'Connected to strategy', text: 'The best committees look forward, asking whether controls, investments, people and culture fit where the organisation is going.' },
  { n: '04', title: 'Reporting that informs decisions', text: 'Impact is measured not by meetings held but by the quality of the decisions that follow.' },
];
---

<BaseLayout>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="hero__shapes" aria-hidden="true">
      <span class="hs hs--1"></span>
      <span class="hs hs--2"></span>
      <span class="hs hs--3"></span>
    </div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Boardroom Governance Summit · Accra, Ghana</p>
        <h1>The Africa we desire starts in the boardroom.</h1>
        <p class="lead">
          Africa's pioneering boardroom-focused summit. Once a year, board chairpersons, directors, chief executives,
          regulators and policymakers gather in Accra to confront how governance really works under pressure.
        </p>
        <div class="btn-row">
          <a class="btn" href={nextEdition.href}>{nextEdition.ctaLabel}<Icon name="arrow-right" /></a>
          <a class="btn btn--ghost-light" href="/summit-2026/">Relive BGS 2026</a>
        </div>
        <dl class="hero__facts">
          <div>
            <dt>Next edition</dt>
            <dd>BGS {nextEdition.year} · dates to be announced</dd>
          </div>
          <div>
            <dt>Home</dt>
            <dd>{contact.venue}, Accra</dd>
          </div>
        </dl>
      </div>

      <div class="hero__media">
        <div class="hero__frame" data-hero-slides={JSON.stringify(slides)}>
          <Image
            src={heroImg}
            alt="Moments from the Boardroom Governance Summit 2026"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1000px) 42vw, 92vw"
            loading="eager"
            fetchpriority="high"
            class="hero__slide is-active"
          />
          <div class="hero__bars" aria-hidden="true"></div>
        </div>
        <div class="hero__card">
          <Image src={wordmark2026} alt="Boardroom Governance Summit 2026" width={220} densities={[1, 2]} />
          <p class="hero__card-theme">Board Committees: From Oversight to Impact</p>
          <p class="hero__card-meta"><span class="dot"></span> Concluded · 12 November 2026</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Hero slideshow: a new BGS 2026 photo every 4 seconds
    const frame = document.querySelector<HTMLElement>('[data-hero-slides]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (frame && !reduce) {
      const urls: string[] = JSON.parse(frame.dataset.heroSlides!);
      const bars = frame.querySelector<HTMLElement>('.hero__bars')!;
      const slides: HTMLImageElement[] = [frame.querySelector<HTMLImageElement>('.hero__slide')!];
      for (const url of urls) {
        const img = new Image();
        img.className = 'hero__slide';
        img.alt = '';
        img.decoding = 'async';
        img.dataset.src = url;
        frame.insertBefore(img, bars);
        slides.push(img);
      }
      slides.forEach(() => bars.append(document.createElement('i')));
      const marks = [...bars.children] as HTMLElement[];
      const load = (img: HTMLImageElement) => {
        if (img.dataset.src) {
          img.src = img.dataset.src;
          delete img.dataset.src;
        }
        const ready = img.decode ? img.decode().catch(() => {}) : Promise.resolve();
        // never let a slow photo stall the rotation
        return Promise.race([ready, new Promise((r) => setTimeout(r, 1200))]);
      };
      let i = 0;
      marks[0].classList.add('is-on');
      load(slides[1]);
      const next = async () => {
        if (document.hidden) return;
        const n = (i + 1) % slides.length;
        await load(slides[n]);
        slides[i].classList.replace('is-active', 'is-leaving');
        const old = slides[i];
        setTimeout(() => old.classList.remove('is-leaving'), 1400);
        slides[n].classList.add('is-active');
        marks[i].classList.remove('is-on');
        marks[n].classList.add('is-on');
        i = n;
        load(slides[(i + 1) % slides.length]);
      };
      setInterval(next, 4000);
    }
  </script>

  <ThankYouBanner />

  <!-- ============================== STATS ============================== -->
  <section class="stats" aria-label="BGS at a glance">
    <div class="container">
      <ul class="stats__grid">
        {
          stats.map((s) => (
            <li data-reveal>
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================== ABOUT ============================== -->
  <section class="section">
    <div class="container split split--wide-left">
      <div class="stack" style="--stack:1.5rem" data-reveal>
        <p class="eyebrow">About the Summit</p>
        <h2>A room built for honest boardroom conversations.</h2>
        <p class="lead">
          The Boardroom Governance Summit brings together top-tier board members, corporate executives, governance
          professionals, regulators and thought leaders from across Africa and beyond.
        </p>
        <ul class="features">
          <li>
            <span class="features__icon"><Icon name="users" /></span>
            <div>
              <h3>Panel discussions</h3>
              <p>Three panels a year on the critical boardroom questions, each followed by open audience Q&amp;A.</p>
            </div>
          </li>
          <li>
            <span class="features__icon"><Icon name="mic" /></span>
            <div>
              <h3>Keynote addresses</h3>
              <p>National leaders, from a Minister for Finance to the Chief of Staff, set the tone for the day.</p>
            </div>
          </li>
          <li>
            <span class="features__icon"><Icon name="network" /></span>
            <div>
              <h3>Networking that lasts</h3>
              <p>Meet chairpersons, CEOs, regulators and policymakers who are hard to reach on a normal working day.</p>
            </div>
          </li>
        </ul>
        <a class="link-arrow" href="/about/">More about the summit <Icon name="arrow-right" /></a>
      </div>

      <div class="collage" data-reveal>
        <div class="media collage__a">
          <Image src={about1} alt="A delegate receives a citation at BGS 2025" widths={[500, 900]} sizes="(min-width: 900px) 40vw, 90vw" />
        </div>
        <div class="media collage__b">
          <Image src={about2} alt="Guests of honour seated at BGS 2025" widths={[400, 700]} sizes="(min-width: 900px) 20vw, 45vw" />
        </div>
        <div class="media collage__c">
          <Image src={about3} alt="Delegates at BGS 2025" widths={[400, 700]} sizes="(min-width: 900px) 20vw, 45vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== 2026 IN REVIEW ============================== -->
  <section class="section section--dark review">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow eyebrow--gold">BGS 2026 in review</p>
          <h2>From oversight to impact.</h2>
        </div>
        <p class="lead">
          For the first time on an African platform of this scale, BGS 2026 put board committees under the spotlight:
          audit, risk, remuneration, nominations, finance and ESG.
        </p>
      </div>

      <article class="event-card" data-reveal>
        <div class="event-card__date" aria-hidden="true">
          <span>Nov</span>
          <strong>12</strong>
          <span>2026</span>
        </div>
        <div class="event-card__body">
          <p class="mono text-gold">12 November 2026 · Labadi Beach Hotel, Accra &amp; online</p>
          <h3>Board Committees: From Oversight to Impact</h3>
          <p>
            Chaired by H.E. Dr. Ekwow Spio-Garbrah, Senior Advisor to the President and Presidential Special Envoy for Reparations, and
            convened by Ing. Prof. Douglas Boateng.
          </p>
          <div class="event-card__links">
            <a class="link-arrow" href="/summit-2026/">Read the 2026 recap <Icon name="arrow-right" /></a>
            <a class="link-arrow" href="/2026/11/13/chairmans-address-the-africa-we-desire-starts-in-the-boardroom/"
              >Chairman's address <Icon name="arrow-right" /></a
            >
          </div>
        </div>
      </article>

      <ol class="takeaways">
        {
          takeaways.map((t, i) => (
            <li data-reveal style={`transition-delay:${i * 80}ms`}>
              <span class="mono">{t.n}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="takeaways__source mono">Four reflections from the Chairman's address, BGS 2026</p>

      <div class="review__photos">
        <div class="media" data-reveal>
          <Image src={r1} alt="Speakers, partners and guests on stage at BGS 2026" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 95vw" />
        </div>
        <div class="media" data-reveal>
          <Image src={r2} alt="The Chairman's address at BGS 2026" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 95vw" />
        </div>
        <div class="media" data-reveal>
          <Image src={r3} alt="Delegates in the hall at BGS 2026" widths={[400, 700]} sizes="(min-width: 900px) 25vw, 95vw" />
        </div>
      </div>

      <div class="sessions">
        <div class="sessions__head">
          <p class="eyebrow eyebrow--gold">Watch BGS 2026</p>
          <h3>The full summit, session by session.</h3>
        </div>
        <div class="sessions__grid">
          <figure data-reveal>
            <VideoEmbed id="754sumgrPpo" title="BGS 2026: Opening session" poster={r2} />
            <figcaption>
              <span class="mono">Morning</span>
              <strong>Opening session</strong>
              <span>Welcome, the Chairman's rallying call and the first two panels.</span>
            </figcaption>
          </figure>
          <figure data-reveal>
            <VideoEmbed id="4FOVdT1Xd7o" title="BGS 2026: Afternoon session" poster={r1} />
            <figcaption>
              <span class="mono">Afternoon</span>
              <strong>Afternoon session</strong>
              <span>The Finance and Audit Committee panel and the delegates' open forum.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== FACES OF 2026 ============================== -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Faces of BGS 2026</p>
          <h2>On the stage in Accra.</h2>
        </div>
        <p class="lead">
          The Chairman of the Summit and our Special Guests of Honour, alongside eleven panellists across three
          committee panels. Select a portrait to read the profile.
        </p>
      </div>
      <div class="speaker-grid">
        {faces.map((p) => <SpeakerCard speaker={p} />)}
      </div>
      <p class="faces__more">
        <a class="btn btn--ghost" href="/past-speakers/">All speakers and panellists <Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>
  <SpeakerDialog />

  <!-- ============================== EDITIONS ============================== -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Three editions</p>
          <h2>One conviction: governance is decided in the boardroom.</h2>
        </div>
        <p class="lead">
          Since its maiden edition in 2024, BGS has grown from 700 executives to more than 1,000 boardroom leaders,
          each year tackling one question boards would rather avoid.
        </p>
      </div>
      <EditionsTimeline />
    </div>
  </section>

  <!-- ============================== CONVENER ============================== -->
  <section class="section">
    <div class="container split split--wide-right">
      <div class="convener__media" data-reveal>
        <div class="media">
          <Image src={convener} alt="Ing. Prof. Douglas Boateng on stage at the Boardroom Governance Summit" widths={[500, 900]} sizes="(min-width: 900px) 40vw, 92vw" />
        </div>
      </div>
      <div class="stack" style="--stack:1.5rem" data-reveal>
        <p class="eyebrow">Message from the Convener</p>
        <blockquote class="convener__quote">
          <p>
            “Boardrooms must evolve, not just to meet compliance standards, but to lead with integrity, foresight and
            impact.”
          </p>
        </blockquote>
        <p>
          The Boardroom Governance Summit was created to foster critical dialogue, share insights and strengthen
          corporate governance practices across Africa. In an era marked by disruption, innovation and growing
          stakeholder expectations, it brings together seasoned leaders, emerging thinkers, regulators and
          professionals committed to raising the bar of accountability and strategic leadership.
        </p>
        <p>
          Thank you for being part of this movement. I look forward to the connections, conversations and commitments
          that will shape better boardrooms and, ultimately, better organisations.
        </p>
        <div class="signature">
          <span class="kente-rule"><span></span></span>
          <p><strong>Ing. Prof. Douglas Boateng</strong><br /><span class="muted">Founder and Convener, Boardroom Governance Summit</span></p>
        </div>
        <a class="link-arrow" href="/the-convener/">About the Convener <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <LogoMarquee />

  <!-- ============================== BEYOND THE SUMMIT ============================== -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack">
          <p class="eyebrow">Beyond the summit</p>
          <h2>The conversation continues all year.</h2>
        </div>
        <p class="lead">One day in Accra is the start of the relationship, not the whole of it.</p>
      </div>
      <div class="pillars">
        <article class="pillar" data-reveal>
          <p class="pillar__tag">Education · Coming soon</p>
          <h3>Certified Board Governance Course</h3>
          <p>
            A self-paced, engaging learning experience for directors and executives. BGS 2026 delegates get first
            access. Watch your registration email for details.
          </p>
          <a class="link-arrow" href="/2026/11/13/certified-board-governance-course/">Course announcement <Icon name="arrow-right" /></a>
        </article>
        <article class="pillar" data-reveal>
          <p class="pillar__tag">Publications</p>
          <h3>Knowledge Development Series</h3>
          <p>
            Practical, authoritative books by Prof. Boateng on boardroom governance, negotiations, strategic sourcing and
            sustainable development. Every delegate takes one home.
          </p>
          <a class="link-arrow" href="/books/">Browse the books <Icon name="arrow-right" /></a>
        </article>
        <article class="pillar" data-reveal>
          <p class="pillar__tag">Thought leadership</p>
          <h3>NyansaKasa and the op-ed series</h3>
          <p>
            Words of Wisdom, plus two weekly series: The Inconvenient Truth and What Is Wrong With Us. Uncomfortable
            questions for Africa's boardrooms.
          </p>
          <a class="link-arrow" href="/news/?category=Insights">Read the insights <Icon name="arrow-right" /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================== VIDEO ============================== -->
  <section class="section section--navy">
    <div class="container split split--wide-right">
      <div class="stack" style="--stack:1.4rem">
        <p class="eyebrow eyebrow--gold">Boardroom trends</p>
        <h2>Key insights from top executives.</h2>
        <p class="lead">
          Hear how evolving governance practices are redefining leadership in Africa and beyond, in the words of the
          people who sit at the table.
        </p>
        <a class="link-arrow on-dark" href="/main-gallery/">See every edition in pictures <Icon name="arrow-right" /></a>
      </div>
      <VideoEmbed id="Wq2lG365Jc0" title="Boardroom Governance Summit: key insights from top executives" poster={videoPoster} />
    </div>
  </section>

  <!-- ============================== NEWS ============================== -->
  <section class="section">
    <div class="container">
      <div class="news-head">
        <div class="stack">
          <p class="eyebrow">News &amp; insights</p>
          <h2>Latest from BGS.</h2>
        </div>
        <a class="btn btn--ghost" href="/news/">All news &amp; insights <Icon name="arrow-right" /></a>
      </div>
      <div>
        <LatestNews server:defer>
          <div slot="fallback" class="sk-cards" aria-hidden="true"><div><i></i><b></b><b></b></div><div><i></i><b></b><b></b></div><div><i></i><b></b><b></b></div></div>
        </LatestNews>
      </div>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="section section--paper">
    <div class="container split split--top">
      <div class="stack faq-intro" style="--stack:1.5rem">
        <p class="eyebrow">FAQs</p>
        <h2>Before you decide, ask us directly.</h2>
        <p class="lead">Straight answers about the summit, who's in the room and what you walk away with.</p>
        <a class="link-arrow" href="/frequently-asked-questions-faqs/">All questions <Icon name="arrow-right" /></a>
        <ul class="contact-mini">
          <li>
            <span class="mono">Call</span>
            <a href={contact.phoneHref}>{contact.phone}</a>
          </li>
          <li>
            <span class="mono">WhatsApp</span>
            <a href={contact.whatsappHref} target="_blank" rel="noopener">{contact.whatsapp}</a>
          </li>
          <li>
            <span class="mono">Email</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
        </ul>
      </div>
      <FaqList items={faqs} openFirst />
    </div>
  </section>

  <CtaBand image={ctaImg} />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-950);
    color: var(--white);
    padding-block: clamp(3rem, 2rem + 5vw, 7rem) clamp(4rem, 3rem + 5vw, 8rem);
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4.5rem;
    }
  }
  .hero__copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  .hero h1 {
    font-size: var(--fs-h1);
    max-width: 13ch;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hero .lead {
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 0.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    width: 100%;
  }
  .hero__facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .hero__facts dd {
    margin: 0.3rem 0 0;
    font-weight: 500;
  }
  .hero__media {
    position: relative;
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }
  .hero__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px var(--radius) var(--radius);
  }
  .hero__frame {
    position: relative;
    isolation: isolate;
    background: var(--navy-850);
  }
  .hero__frame :global(.hero__slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    opacity: 0;
    clip-path: inset(100% 0 0 0);
    transform: scale(1.18);
  }
  .hero__frame :global(.hero__slide.is-active) {
    z-index: 2;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: scale(1.04);
    transition:
      clip-path 1.2s cubic-bezier(0.7, 0, 0.2, 1),
      transform 5.2s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .hero__frame :global(.hero__slide.is-leaving) {
    z-index: 1;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: scale(1.1) translateY(-3%);
    filter: brightness(0.6);
    transition:
      transform 1.4s cubic-bezier(0.7, 0, 0.2, 1),
      filter 1.4s;
  }
  .hero__bars {
    position: absolute;
    z-index: 3;
    top: 22%;
    right: 0.9rem;
    display: grid;
    gap: 6px;
  }
  .hero__bars :global(i) {
    width: 4px;
    height: 22px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
    position: relative;
  }
  .hero__bars :global(i)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: top;
  }
  .hero__bars :global(i.is-on)::after {
    transform: scaleY(1);
    transition: transform 4s linear;
  }
  .hero__card {
    position: absolute;
    z-index: 4;
    left: -1.5rem;
    bottom: 2rem;
    display: grid;
    gap: 0.7rem;
    max-width: 290px;
    padding: 1.25rem 1.35rem;
    border-radius: 16px;
    background: rgba(2, 11, 38, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line-dark);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
