---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type SpeakerLike = {
  name: string;
  role: string;
  badge?: string;
  bio?: string;
  image?: ImageMetadata;
  tone?: 'navy' | 'red' | 'gold' | 'ink' | 'green' | 'plum';
};

interface Props {
  speaker: SpeakerLike;
  /** Smaller card for dense grids (panels). */
  compact?: boolean;
}
const { speaker, compact = false } = Astro.props;
const tones = ['navy', 'red', 'gold', 'ink'] as const;
const tone = speaker.tone ?? tones[[...speaker.name].reduce((a, c) => a + c.charCodeAt(0), 0) % tones.length];
const TITLES = /^(HE|H\.E\.|Hon\.?|Dr\.?|Prof\.?|Professor|Mrs\.?|Mr\.?|Ms\.?|Chief|Ing\.?|Otunba)$/;
const words = speaker.name.replace(/,.*$/, '').split(/\s+/).filter((w) => !TITLES.test(w));
const initials = ((words[0]?.[0] ?? '') + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase();
const Tag = speaker.bio ? 'button' : 'div';
---

<article class:list={['speaker', `speaker--${tone}`, { 'speaker--compact': compact }]}>
  <Tag
    class="speaker__media"
    type={speaker.bio ? 'button' : undefined}
    data-speaker={speaker.bio ? '' : undefined}
    data-name={speaker.bio ? speaker.name : undefined}
    data-role={speaker.bio ? speaker.role : undefined}
    data-bio={speaker.bio}
    aria-label={speaker.bio ? `Read profile: ${speaker.name}` : undefined}
  >
    {
      speaker.image ? (
        <Image src={speaker.image} alt={speaker.name} widths={[240, 400, 600]} sizes="(min-width: 1000px) 22vw, 45vw" />
      ) : (
        <span class="speaker__initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
    {speaker.bio && <span class="speaker__more" aria-hidden="true">+</span>}
  </Tag>
  {speaker.badge && <span class="speaker__badge">{speaker.badge}</span>}
  <h3>{speaker.name}</h3>
  <p>{speaker.role}</p>
</article>

<style>
  .speaker {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    text-align: center;
  }
  .speaker__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.18), transparent 60%),
      var(--tone);
    margin-bottom: 0.35rem;
    font: inherit;
    color: inherit;
  }
  button.speaker__media {
    cursor: pointer;
  }
  .speaker--navy {
    --tone: var(--navy-800);
  }
  .speaker--red {
    --tone: #8f1717;
  }
  .speaker--gold {
    --tone: #9c7905;
  }
  .speaker--ink {
    --tone: #1f2a44;
  }
  .speaker--green {
    --tone: #1e6b3c;
  }
  .speaker--plum {
    --tone: #5b2d6e;
  }
  .speaker__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s var(--ease);
  }
  button.speaker__media:hover :global(img) {
    transform: scale(1.04);
  }
  .speaker__initials {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.92);
  }
  .speaker__badge {
    justify-self: center;
    margin-top: -1.4rem;
    position: relative;
    z-index: 1;
    max-width: calc(100% - 1rem);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--red);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    box-shadow: 0 4px 14px -4px rgba(2, 11, 38, 0.5);
  }
  .speaker__more {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--navy-950);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1;
    transition: transform 0.3s var(--ease), background-color 0.2s;
  }
  button.speaker__media:hover .speaker__more,
  button.speaker__media:focus-visible .speaker__more {
    transform: rotate(90deg) scale(1.1);
    background: var(--gold);
  }
  .speaker {
    transition: transform 0.35s var(--ease);
  }
  .speaker:has(button.speaker__media:hover) {
    transform: translateY(-6px);
  }
  .speaker h3 {
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .speaker p {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .speaker--compact h3 {
    font-size: 0.98rem;
  }
  .speaker--compact p {
    font-size: 0.8rem;
  }
  :global(.section--dark) .speaker p,
  :global(.section--navy) .speaker p {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
