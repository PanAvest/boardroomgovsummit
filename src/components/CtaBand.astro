---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import defaultImage from '../assets/images/events/2024/bgs-2024-162.jpg';
import { nextEdition } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  image?: ImageMetadata;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  title = "We're looking forward to welcoming you.",
  text = `Be first to hear the dates, theme and speakers for BGS ${nextEdition.year}.`,
  image = defaultImage,
  primary = { label: nextEdition.ctaLabel, href: nextEdition.href },
  secondary = { label: 'Partner with BGS', href: '/sponsorship/' },
} = Astro.props;
---

<section class="cta-band">
  <Image src={image} alt="" widths={[800, 1400, 2000]} sizes="100vw" class="cta-band__bg" />
  <div class="container cta-band__inner on-dark" data-reveal>
    <span class="kente-rule"><span></span></span>
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn" href={primary.href}>{primary.label}<Icon name="arrow-right" /></a>
      {secondary && <a class="btn btn--ghost-light" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--white);
    padding-block: clamp(6rem, 4rem + 8vw, 11rem);
    text-align: center;
  }
  :global(.cta-band__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at center, rgba(2, 11, 38, 0.45), rgba(2, 11, 38, 0.82) 80%),
      linear-gradient(180deg, rgba(2, 11, 38, 0.15), rgba(2, 11, 38, 0.6));
  }
  .cta-band__inner {
    display: grid;
    justify-items: center;
    gap: 1.4rem;
  }
  .cta-band h2 {
    max-width: 16ch;
  }
  .cta-band p {
    max-width: 48ch;
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-band .btn-row {
    justify-content: center;
    margin-top: 0.5rem;
  }
</style>
