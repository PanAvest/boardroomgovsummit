---
import Icon from './Icon.astro';
import type { Faq } from '../data/site';

interface Props {
  items: Faq[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          <span>{f.q}</span>
          <span class="faq__icon">
            <Icon name="plus" size={18} />
          </span>
        </summary>
        <div class="faq__answer">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--navy-800);
  }
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform 0.25s var(--ease),
      background-color 0.2s;
  }
  details[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--red);
    border-color: var(--red);
    color: var(--white);
  }
  .faq__answer {
    padding: 0 3.5rem 1.6rem 0;
    color: var(--ink-2);
    line-height: 1.7;
  }
</style>
