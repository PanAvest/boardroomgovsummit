---
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'chevron-down'
    | 'menu'
    | 'close'
    | 'phone'
    | 'mail'
    | 'whatsapp'
    | 'linkedin'
    | 'x'
    | 'facebook'
    | 'instagram'
    | 'play'
    | 'download'
    | 'calendar'
    | 'pin'
    | 'users'
    | 'mic'
    | 'network'
    | 'book'
    | 'award'
    | 'link'
    | 'plus';
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17L17 7M8 7h9v9" />}
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {
    name === 'phone' && (
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="M3 7l9 6 9-6" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M3 21l1.65-3.8A9 9 0 1 1 8.4 20.3L3 21" />
        <path d="M9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2.1-1-1 1a4 4 0 0 1-2.3-2.3l1-1-1-2.1z" />
      </>
    )
  }
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0" />
      </>
    )
  }
  {name === 'x' && <path d="M4 4l16 16M20 4L4 20" />}
  {name === 'facebook' && <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z" />}
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5v.01" />
      </>
    )
  }
  {name === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" stroke="none" />}
  {name === 'download' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {
    name === 'calendar' && (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 10h18" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z" />
        <circle cx="12" cy="9" r="2.5" />
      </>
    )
  }
  {
    name === 'users' && (
      <>
        <circle cx="9" cy="8" r="3.5" />
        <path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5" />
      </>
    )
  }
  {
    name === 'mic' && (
      <>
        <rect x="9" y="3" width="6" height="11" rx="3" />
        <path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
      </>
    )
  }
  {
    name === 'network' && (
      <>
        <circle cx="12" cy="5" r="2.5" />
        <circle cx="5" cy="18" r="2.5" />
        <circle cx="19" cy="18" r="2.5" />
        <path d="M10.8 7.2L6.2 15.8M13.2 7.2l4.6 8.6M7.5 18h9" />
      </>
    )
  }
  {name === 'book' && <path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7" />}
  {
    name === 'award' && (
      <>
        <circle cx="12" cy="9" r="6" />
        <path d="M8.5 13.9L7 22l5-3 5 3-1.5-8.1" />
      </>
    )
  }
  {name === 'link' && <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />}
</svg>
