---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: { label: string; href?: string }[];
  /** circle = inspiration-style round crop; frame = rounded rectangle */
  imageShape?: 'circle' | 'frame';
  compact?: boolean;
}
const { eyebrow, title, lead, image, imageAlt = '', crumbs, imageShape = 'frame', compact = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--compact': compact, 'page-hero--with-image': !!image }]}>
  <div class="page-hero__shapes" aria-hidden="true">
    <span class="shape shape--a"></span>
    <span class="shape shape--b"></span>
  </div>
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      {
        crumbs && (
          <nav aria-label="Breadcrumb" class="crumbs">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              {crumbs.map((c) => (
                <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <div class:list={['page-hero__media', `page-hero__media--${imageShape}`]}>
          <Image src={image} alt={imageAlt} widths={[480, 760, 1100]} sizes="(min-width: 900px) 40vw, 90vw" loading="eager" />
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-950);
    color: var(--white);
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 7.5rem);
  }
  .page-hero--compact {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .page-hero__inner {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .page-hero--with-image .page-hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }
  .page-hero__copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .page-hero h1 {
    max-width: 17ch;
  }
  .page-hero--compact h1 {
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4.4rem);
  }
  .page-hero .lead {
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .page-hero .eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }
  .page-hero__media {
    position: relative;
  }
  .page-hero__media :global(img) {
    width: 100%;
    object-fit: cover;
  }
  .page-hero__media--frame :global(img) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }
  .page-hero__media--circle {
    max-width: 520px;
    justify-self: center;
    width: 100%;
  }
  .page-hero__media--circle :global(img) {
    aspect-ratio: 1;
    border-radius: 50%;
    object-position: center top;
    background: radial-gradient(circle at 50% 30%, var(--navy-700), var(--navy-850) 70%);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.5;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--gold);
  }

  .page-hero__shapes .shape {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .shape--a {
    width: 520px;
    height: 520px;
    left: -260px;
    bottom: -300px;
    background: var(--navy-800);
    opacity: 0.55;
  }
  .shape--b {
    width: 300px;
    height: 300px;
    right: -150px;
    top: -170px;
    background: var(--red);
    opacity: 0.18;
  }
</style>
