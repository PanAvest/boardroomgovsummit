---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
}
const { id, title, poster } = Astro.props;
---

<div class="video" data-video={id} data-title={title}>
  <Image src={poster} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 55vw, 95vw" />
  <button type="button" class="video__play" aria-label={`Play video: ${title}`}>
    <span class="video__btn"><Icon name="play" size={26} /></span>
    <span class="video__label">Watch video</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.video}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      el.classList.add('is-playing');
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: #000;
  }
  .video :global(img),
  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(2, 11, 38, 0.35);
    pointer-events: none;
  }
  .video.is-playing::after {
    display: none;
  }
  .video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    border: 0;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .video__btn {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--red);
    padding-left: 4px;
    transition: transform 0.25s var(--ease);
  }
  .video__play:hover .video__btn {
    transform: scale(1.08);
  }
  .video__label {
    font-weight: 600;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
  }
</style>
