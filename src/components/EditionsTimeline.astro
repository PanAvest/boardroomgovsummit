---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { editions } from '../data/site';
---

<ol class="editions">
  {
    editions.map((e, i) => (
      <li class="edition" data-reveal style={`transition-delay:${i * 90}ms`}>
        <div class="edition__media">
          <Image src={e.image} alt={`BGS ${e.year}`} widths={[480, 800]} sizes="(min-width: 1000px) 30vw, 90vw" />
          <span class="edition__year">{e.year}</span>
        </div>
        <div class="edition__body">
          <p class="eyebrow">
            {e.label} · {e.date}
          </p>
          <h3>{e.theme}</h3>
          <p class="edition__summary">{e.summary}</p>
          <ul class="edition__facts">
            <li>
              <Icon name="mic" size={16} />
              {e.keynote}
            </li>
            <li>
              <Icon name="users" size={16} />
              {e.attendance}
            </li>
            <li>
              <Icon name="pin" size={16} />
              Labadi Beach Hotel, Accra
            </li>
          </ul>
          <div class="edition__links">
            {e.links.map((l) => (
              <a class="link-arrow" href={l.href}>
                {l.label}
                <Icon name="arrow-right" />
              </a>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .editions {
    list-style: none;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1000px) {
    .editions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .edition {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .section--dark .edition {
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--line-dark);
  }
  .edition__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .edition__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .edition:hover .edition__media :global(img) {
    transform: scale(1.04);
  }
  .edition__year {
    position: absolute;
    left: 1rem;
    bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--white);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }
  .edition__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    padding: 1.6rem 1.6rem 1.8rem;
  }
  .edition h3 {
    font-size: 1.3rem;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }
  .edition__summary {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .section--dark .edition__summary {
    color: rgba(255, 255, 255, 0.7);
  }
  .edition__facts {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
  }
  .section--dark .edition__facts {
    border-color: var(--line-dark);
  }
  .edition__facts li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }
  .edition__facts :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--red);
  }
  .edition__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
