---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoWhite from '../assets/images/brand/bgs-logo-white.png';
import { nav, nextEdition } from '../data/site';

interface Props {
  theme?: 'dark' | 'light';
}
const path = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) =>
  href === '/' ? path === '/' : path.startsWith(href) || !!children?.some((c) => path.startsWith(c.href));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Boardroom Governance Summit, home">
      <Image src={logoWhite} alt="" width={180} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {
          nav.map((item, i) =>
            item.children ? (
              <li class="nav__item has-menu" data-menu>
                <button
                  type="button"
                  class:list={['nav__link', { 'is-active': isActive(item.href, item.children) }]}
                  aria-expanded="false"
                  aria-controls={`menu-${i}`}
                >
                  {item.label}
                  <Icon name="chevron-down" size={14} />
                </button>
                <div class="nav__menu" id={`menu-${i}`}>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                          <span class="nav__menu-label">{c.label}</span>
                          {c.note && <span class="nav__menu-note">{c.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={item.href}
                  class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                  aria-current={path === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a href={nextEdition.href} class="btn btn--sm header-cta">
      {nextEdition.ctaShort}
    </a>

    <button type="button" class="burger" aria-expanded="false" aria-controls="mobile-nav" data-burger>
      <span class="sr-only">Open menu</span>
      <Icon name="menu" size={24} class="burger__open" />
      <Icon name="close" size={24} class="burger__close" />
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <div class="container">
      <ul>
        {
          nav.map((item) =>
            item.children ? (
              <li>
                <details>
                  <summary>
                    {item.label}
                    <Icon name="plus" size={18} />
                  </summary>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class="mobile-nav__top">
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a href={nextEdition.href} class="btn mobile-nav__cta">
        {nextEdition.ctaLabel}
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Desktop dropdowns: click / keyboard, plus hover via CSS
  const menus = header.querySelectorAll<HTMLElement>('[data-menu]');
  const closeAll = (except?: HTMLElement) =>
    menus.forEach((m) => {
      if (m !== except) m.querySelector('button')?.setAttribute('aria-expanded', 'false');
    });
  menus.forEach((m) => {
    const btn = m.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(m);
      btn.setAttribute('aria-expanded', String(!open));
    });
    m.addEventListener('focusout', (e) => {
      if (!m.contains(e.relatedTarget as Node)) btn.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) closeAll();
  });

  // Mobile menu
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const panel = header.querySelector<HTMLElement>('[data-mobile-nav]')!;
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    panel.hidden = open;
    document.body.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(2, 11, 38, 0.92);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid transparent;
    color: var(--white);
    transition: border-color 0.2s;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line-dark);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .brand {
    flex: none;
    margin-right: auto;
  }
  .brand img {
    width: 168px;
    height: auto;
  }

  .nav {
    display: none;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .nav__link:hover,
  .nav__link[aria-expanded='true'] {
    color: var(--white);
    background: rgba(255, 255, 255, 0.07);
  }
  .nav__link.is-active {
    color: var(--white);
    box-shadow: inset 0 -2px 0 var(--red);
    border-radius: 0;
  }
  .nav__link :global(svg) {
    transition: transform 0.2s;
    opacity: 0.7;
  }
  .nav__link[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    min-width: 290px;
    padding: 0.5rem;
    background: var(--white);
    color: var(--ink);
    border-radius: 14px;
    box-shadow:
      0 20px 50px -12px rgba(2, 11, 38, 0.45),
      0 0 0 1px rgba(2, 11, 38, 0.06);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      visibility 0.18s;
  }
  .nav__menu::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .nav__menu ul {
    list-style: none;
  }
  .nav__menu a {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    text-decoration: none;
  }
  .nav__menu a:hover,
  .nav__menu a[aria-current='page'] {
    background: var(--paper);
  }
  .nav__menu-label {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav__menu-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .has-menu:hover .nav__menu,
  .has-menu:has([aria-expanded='true']) .nav__menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .header-cta {
    display: none;
  }

  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }
  .burger :global(.burger__close) {
    display: none;
  }
  .burger[aria-expanded='true'] :global(.burger__open) {
    display: none;
  }
  .burger[aria-expanded='true'] :global(.burger__close) {
    display: block;
  }

  .mobile-nav {
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    border-top: 1px solid var(--line-dark);
    padding-block: 1rem 2rem;
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav ul {
    list-style: none;
  }
  .mobile-nav > .container > ul > li {
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile-nav summary,
  .mobile-nav__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.05rem 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .mobile-nav details ul {
    padding: 0 0 1rem 0.25rem;
  }
  .mobile-nav details a {
    display: block;
    padding: 0.55rem 0;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
  }
  .mobile-nav__cta {
    width: 100%;
    margin-top: 1.5rem;
  }

  @media (min-width: 1120px) {
    .nav {
      display: block;
    }
    .burger,
    .mobile-nav {
      display: none !important;
    }
    .header-cta {
      display: inline-flex;
    }
    .brand {
      margin-right: 0;
    }
    .nav {
      margin-inline: auto;
    }
  }
  @media (min-width: 600px) and (max-width: 1119px) {
    .header-cta {
      display: inline-flex;
    }
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>
